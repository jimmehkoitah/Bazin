# Copy to .env. All variables are optional; missing credentials disable the corresponding source or switch the LLM to heuristic mode.
BAZIN_ENV=dev
BAZIN_DATABASE_URL=postgresql://postgres@127.0.0.1:54329/bazin_test

# LLM (Anthropic). Without a key the pipeline runs the deterministic heuristic fallback.
BAZIN_ANTHROPIC_API_KEY=
BAZIN_FAKE_LLM=false
BAZIN_LLM_BUDGET_USD=400
BAZIN_USE_BATCHES=true
# Per-stage overrides, e.g. BAZIN_MODEL_CLASSIFY=claude-sonnet-5

# Embeddings (Voyage AI). Without a key a hashing embedder is used.
BAZIN_VOYAGE_API_KEY=
BAZIN_EMBEDDING_MODEL=voyage-multimodal-3

# Sources
BAZIN_APIFY_TOKEN=
BAZIN_BRAVE_API_KEY=
BAZIN_GOOGLE_CSE_KEY=
BAZIN_GOOGLE_CSE_CX=
BAZIN_YOUTUBE_API_KEY=
BAZIN_ETSY_API_KEY=
BAZIN_YELP_API_KEY=

# Crawl behaviour
BAZIN_MAX_POSTS_PER_PROFILE=30
BAZIN_RAW_STORE_DIR=.raw
